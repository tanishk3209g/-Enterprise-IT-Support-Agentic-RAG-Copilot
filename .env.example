# Application Configuration
APP_NAME="Enterprise IT Support Agentic RAG Copilot"
APP_ENV="development"
ADMIN_API_KEY="change-me"

# LLM Provider: "groq" or "gemini"
LLM_PROVIDER="groq"

# Groq (Free fast tier - get free key at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini (Free tier - get free key at https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Embeddings (100% Free local HuggingFace - zero API key required)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ChromaDB Collection (Stored locally in data/chroma_db - zero API key required)
CHROMA_COLLECTION_NAME=company_it_kb

# Web Search uses DuckDuckGo automatically with zero API key!

# Retrieval Settings
TOP_K=4
MAX_RETRIES=1
